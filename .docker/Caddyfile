{
    # https://caddyserver.com/docs/caddyfile/options#log
    log {
        level INFO
        output stdout
        format console
    }

    # https://caddyserver.com/docs/caddyfile/options#admin
    admin off
    persist_config off

    # https://caddyserver.com/docs/caddyfile/patterns#caddy-proxying-to-another-caddy
    servers {
        trusted_proxies static private_ranges
    }
}

(server_conf) {
    # 0. Root MUST be defined early so other directives know where files are
    root * /app/public

    # 1. Block crawlers and robots
    respond /robots.txt "User-agent: *\nDisallow: /"

    # 2. Return an early 204 No Content for favicon images
    # We use a matcher to group these together
    @ignored_files {
        path /favicon.ico
    }
    error @ignored_files 204

    # 3. Refuse multipart bodies, which PHP-FPM parses before the server's code runs
    # (CVE-2026-109618, CVE-2026-109619). MCP clients send JSON, so none is legitimate here.
    @multipart header_regexp Content-Type (?i)multipart
    respond @multipart 415

    # 4. Cap request bodies, also those sent without a Content-Length; matches post_max_size
    request_body {
        max_size 8MB
    }

    # 5. Explicitly wire PHP-FPM ping path
    reverse_proxy /health/status app:9000 {
        transport fastcgi {
            split .php
        }
    }

    # Enable PHP processing via FastCGI
    php_fastcgi app:9000

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        X-XSS-Protection "1; mode=block"
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
}

# HTTPS server with internal certificates
{$HOSTNAME} {
    import server_conf

    tls {
        protocols tls1.3
    }

    # Serve static files
    file_server
}

# HTTP development server (no TLS)
:8343 {
    import server_conf

    # Serve static files
    file_server
}
